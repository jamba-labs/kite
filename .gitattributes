# Asset Library archive hygiene.
# The Godot Asset Library installs from GitHub's source archive, which honors
# export-ignore. Strip everything except the addon and license so an install
# drops a clean addons/kite/ into the user's project — no TS source, no
# fixture, no docs.
/src              export-ignore
/test             export-ignore
/tools            export-ignore
/docs             export-ignore
/fixture          export-ignore
/presets          export-ignore
/.github          export-ignore
/package.json     export-ignore
/package-lock.json export-ignore
/tsconfig.json    export-ignore
/llms.txt         export-ignore
/README.md        export-ignore
/CONTRIBUTING.md  export-ignore
/CODE_OF_CONDUCT.md export-ignore
/.gitignore       export-ignore
/.gitattributes   export-ignore
