{
  "kite_contract": "0.1",
  "name": "weighty",
  "extends": null,
  "rules": {
    "input.latency_to_motion_frames": { "max": 5 },
    "jump.apex_time_s": { "range": [0.38, 0.52] },
    "jump.rise_fall_ratio": { "range": [1.3, 1.8] },
    "jump.hang_time_s": { "max": 0.12 },
    "run.accel_time_to_max_s": { "min": 0.35 },
    "run.decel_time_to_stop_s": { "min": 0.3 },
    "run.decel_shape": { "shape": "ease-in", "exponent_max": 0.7 },
    "assist.coyote_window_ms": { "range": [40, 100] }
  }
}
