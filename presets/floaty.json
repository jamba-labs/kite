{
  "kite_contract": "0.1",
  "name": "floaty",
  "extends": null,
  "rules": {
    "input.latency_to_motion_frames": { "max": 6 },
    "jump.apex_time_s": { "range": [0.5, 0.7] },
    "jump.rise_fall_ratio": { "range": [0.8, 1.1] },
    "jump.hang_time_s": { "min": 0.09 },
    "run.accel_time_to_max_s": { "range": [0.2, 0.5] },
    "run.decel_time_to_stop_s": { "min": 0.25 },
    "run.decel_shape": { "shape": "linear" }
  }
}
